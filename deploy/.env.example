# Copied to deploy/.env on the VM, filled there, never committed.
# The server refuses to start in production without the GitHub values.

# The domain of the demo: its DNS points at the VM (PAM-004)
DOMAIN=pamoja.example.sn

# Signs the session cookies: a long random value (openssl rand -hex 32)
SESSION_SECRET=

# The GitHub App (§5.1): its Callback URL is https://DOMAIN/login/github and
# its webhook URL https://DOMAIN/api/github/webhook
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_ID=
# The PEM of the app, on one line with \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Reads the public repos (§5.2)
GITHUB_BOT_TOKEN=

# The assistant (§11), any API compatible with OpenAI
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_NAME=

# The demo developers that are real GitHub accounts (§18.1): login:githubId
SEED_GITHUB_IDS=
