# Copy to .env.production on the server and fill it in. Never commit the copy.
# The server refuses to start in production without the GitHub values.
# Next to docker-compose.yml, .env holds what Compose itself reads:
#   PUBLIC_HOST=       the domain, for Caddy
#   MEILI_MASTER_KEY=  the key of the search (openssl rand -hex 32)

# Signs the session cookies: a long random value (openssl rand -hex 32)
SESSION_SECRET=

# The GitHub App (§5.1): its Callback URL is https://PUBLIC_HOST/login/github
# and its webhook URL https://PUBLIC_HOST/api/github/webhook
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_ID=
# The PEM of the app, on one line with \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Reads the public repos (§5.2)
GITHUB_BOT_TOKEN=

# The models (§11), tried in this order; one without its key is skipped
META_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: dollars Meta may spend in a day, 1 by default (PAM-540)
AI_DAILY_BUDGET=

# The demo developers that are real GitHub accounts (§18.1): login:githubId
SEED_GITHUB_IDS=
